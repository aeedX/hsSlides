cabal-version:      2.4
name:               hs-slides
version:            0.1.0.0
synopsis:           A small PowerPoint-like presentation editor written in Haskell
description:        The editor runs in the browser; all logic, storage and slide
                    rendering are Haskell. Only boot packages plus network are used.
license:            NONE
build-type:         Simple

executable hs-slides
  main-is:          Main.hs
  hs-source-dirs:   src
  other-modules:    Assets
                    Deck
                    Editor
                    Http
                    Render
  build-depends:    base       >=4.14 && <5,
                    bytestring,
                    directory  >=1.3.0.0,
                    filepath,
                    network    >=3.1 && <3.3,
                    text
  default-language: Haskell2010
  ghc-options:      -Wall -O1 -threaded
